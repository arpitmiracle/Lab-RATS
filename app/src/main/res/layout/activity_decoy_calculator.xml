<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calculator"
            android:textColor="#172033"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/calcDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            android:gravity="end|center_vertical"
            android:minHeight="112dp"
            android:padding="16dp"
            android:text="0"
            android:textColor="#111827"
            android:textSize="56sp"
            android:fontFamily="sans-serif-light"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="start" />

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                style="@style/CalcBtn"
                android:layout_weight="1"
                android:backgroundTint="#FDE8E8"
                android:text="C"
                android:textColor="#DC2626" />

            <Button
                style="@style/CalcBtn"
                android:layout_weight="1"
                android:backgroundTint="#EEF2F7"
                android:text="+/-"
                android:textColor="#263449" />

            <Button
                style="@style/CalcBtn"
                android:layout_weight="1"
                android:backgroundTint="#EEF2F7"
                android:text="%"
                android:textColor="#263449" />

            <Button
                style="@style/CalcBtn"
                android:layout_weight="1"
                android:backgroundTint="#E8F0FF"
                android:text="÷"
                android:textColor="#1769E0" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button style="@style/CalcBtn" android:layout_weight="1" android:text="7" />
            <Button style="@style/CalcBtn" android:layout_weight="1" android:text="8" />
            <Button style="@style/CalcBtn" android:layout_weight="1" android:text="9" />
            <Button style="@style/CalcBtn" android:layout_weight="1" android:backgroundTint="#E8F0FF" android:text="×" android:textColor="#1769E0" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button style="@style/CalcBtn" android:layout_weight="1" android:text="4" />
            <Button style="@style/CalcBtn" android:layout_weight="1" android:text="5" />
            <Button style="@style/CalcBtn" android:layout_weight="1" android:text="6" />
            <Button style="@style/CalcBtn" android:layout_weight="1" android:backgroundTint="#E8F0FF" android:text="−" android:textColor="#1769E0" />
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button style="@style/CalcBtn" android:layout_weight="1" android:text="1" />
            <Button style="@style/CalcBtn" android:layout_weight="1" android:text="2" />
            <Button style="@style/CalcBtn" android:layout_weight="1" android:text="3" />
            <Button style="@style/CalcBtn" android:layout_weight="1" android:backgroundTint="#E8F0FF" android:text="+" android:textColor="#1769E0" />
        </LinearLayout>

        <!-- Row 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                style="@style/CalcBtn"
                android:layout_weight="2"
                android:text="0" />

            <Button
                style="@style/CalcBtn"
                android:layout_weight="1"
                android:text="." />

            <Button
                style="@style/CalcBtn"
                android:layout_weight="1"
                android:backgroundTint="#1769E0"
                android:text="="
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
